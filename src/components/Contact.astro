---
import Section from './Section.astro';
import { profile } from '../data/profile';
const { title, note, heading } = profile.contact;
const { email, phone, linkedin, github, url } = profile;
---

<Section id="contact">
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="note">{note}</Fragment>
  <div class="block">
    <h3>{heading}</h3>
    {/* The HTML comment markers stop Cloudflare's Email Address Obfuscation from
        rewriting the address and injecting its render-blocking decoder script. */}
    <p class="email"><!--email_off--><a href={`mailto:${email}`}>{email}</a><!--/email_off--></p>
    <ul class="links">
      <li><a href={linkedin}>LinkedIn</a></li>
      <li><a href={github}>GitHub</a></li>
      <li><a href={phone.href}>{phone.display}</a></li>
      <li><a href={url}>nedilko.dev</a></li>
    </ul>
  </div>
</Section>

<style>
  .block {
    background: var(--accent);
    color: var(--accent-ink);
    padding: 36px 36px 42px;
  }
  h3 {
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 12em;
  }
  .email { margin-top: 24px; font-size: clamp(1.15rem, 2.8vw, 1.6rem); font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 28px; margin-top: 20px; }
  a { text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); }
  a:hover { text-decoration-color: currentColor; }
  a:focus-visible { outline-color: var(--accent-ink); }
</style>
