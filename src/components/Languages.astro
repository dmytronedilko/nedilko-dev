---
import Section from './Section.astro';
import { profile } from '../data/profile';
const { title, note, items } = profile.languages;
---

<Section id="languages">
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="note">{note}</Fragment>
  <ul class="cols">
    {items.map((l) => (
      <li>
        <h3>{l.name}</h3>
        <p>{l.level}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  li { padding-inline: 24px; border-left: 1px solid var(--line); }
  li:first-child { padding-left: 0; border-left: 0; }
  h3 { font-weight: 700; font-size: 19px; line-height: 1.3; }
  p { color: var(--muted); margin-top: 2px; }
  @media (max-width: 860px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    li { padding: 16px 0; border-left: 0; border-top: 1px solid var(--line); }
    li:first-child { padding-top: 0; border-top: 0; }
  }
</style>
